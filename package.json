{
  "name": "ciel", "version": "0.1.4", "private": true, "type": "module",
  "packageManager": "pnpm@11.25.0", "engines": { "node": ">=24.0.0" },
  "scripts": {
    "dev": "concurrently -k -n host,web 'pnpm dev:host' 'pnpm dev:web'",
    "dev:host": "tsx watch apps/host/src/main.ts",
    "dev:web": "pnpm --filter @ciel/web dev",
    "start": "node dist/host/main.cjs",
    "build": "pnpm build:web && pnpm build:host",
    "build:web": "pnpm --filter @ciel/web build",
    "build:host": "esbuild apps/host/src/main.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/host/main.cjs && node scripts/copy-runtime.cjs",
    "typecheck": "tsc --noEmit && pnpm --filter @ciel/web typecheck",
    "test": "vitest run", "test:watch": "vitest", "test:e2e": "playwright test",
    "package": "tsx scripts/package.ts"
  },
  "dependencies": { "@ciel/contracts": "workspace:*", "@ciel/adapters": "workspace:*", "@fastify/static": "^8.3.0", "fastify": "^5.6.0", "zod": "^4.1.0", "diff": "^8.0.0", "ignore": "^7.0.5" },
  "devDependencies": { "@playwright/test": "^1.55.0", "@types/node": "^24.0.0", "@types/diff": "^7.0.2", "concurrently": "^9.2.0", "esbuild": "^0.25.0", "tsx": "^4.20.0", "typescript": "^5.9.0", "vitest": "^3.2.0" }
}
